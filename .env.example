# Copy this file to .env and adjust the values. The setup wizard at /setup can
# generate it for you. .env is git-ignored: it never leaves your server.

# Core app
APP_NAME=raspi-chat
NODE_ENV=production
HOST=127.0.0.1
PORT=3000

# Chat storage and users
CHAT_USERS_FILE=/srv/apps/raspi-chat/config/chat-users.json
CHAT_DB_PATH=/srv/apps/raspi-chat/data/chat.db

# At-rest encryption for chat.db AND for the attachments in data/uploads/.
# Optional: leave it empty and both stay in plaintext. Generate one with:
#   openssl rand -hex 32
# WARNING: lose this key and the encrypted data is UNRECOVERABLE. Keep a copy
# off the Pi (password manager or offline backup). To encrypt existing data:
#   CHAT_DB_KEY=... node ops/encrypt-db.js        # the chat database
#   CHAT_DB_KEY=... node ops/encrypt-uploads.js   # the attachments
CHAT_DB_KEY=

# Secret used to sign session tokens. Changing it logs everyone out.
TOKEN_SECRET=change-me-with-a-long-random-secret

# Set to 1 to hide the account list on the login screen: visitors type their
# username instead of picking a card, and /chat/login-users returns nothing.
# Recommended for internet-facing instances. Empty = the clickable cards.
CHAT_PRIVATE_LOGIN=

# First admin, and the room every user joins on first run.
# DEFAULT_ROOM_ID is a stable key referenced by every message row: pick it
# before the first start and never change it afterwards.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ROOM_ID=general
DEFAULT_ROOM_NAME=General

# Web Push (optional). Without these keys push notifications stay disabled.
# The setup wizard can generate the VAPID key pair for you.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:admin@example.com

# Setup wizard helpers
PUBLIC_HOSTNAME=
SETUP_NETWORK_MODE=lan
